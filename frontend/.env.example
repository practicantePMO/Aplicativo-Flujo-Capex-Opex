# Copia este archivo a ".env.production" (o ".env") y pon los valores reales
# cuando vayas a desplegar. En tu máquina, sin este archivo, la app sigue
# funcionando igual porque usa "http://localhost:3000" por defecto.

VITE_API_URL=https://tu-backend-desplegado.com
# Opcional: si se deja vacío, el botón de Google no aparece.
VITE_GOOGLE_CLIENT_ID=

# Inicio de sesión con Microsoft (Azure AD / Entra ID). Son los mismos valores
# que MICROSOFT_CLIENT_ID y MICROSOFT_TENANT_ID del backend.
# Si se dejan vacíos, el botón de Microsoft no aparece.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
