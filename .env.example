# ==================================================================
# PLANTILLA DE VARIABLES PARA DOCKER COMPOSE (raíz del proyecto)
# Copia este archivo como ".env" (sin ".example") y completa los valores.
# El archivo ".env" NO se sube al repositorio (está en .gitignore).
# ==================================================================

# ---------- PostgreSQL ----------
# Usuario, contraseña y nombre de la base de datos que creará Docker.
# Usa una contraseña larga y aleatoria.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=proyectos_db

# ---------- RabbitMQ ----------
# Usuario y contraseña del servidor de mensajería.
RABBITMQ_USER=
RABBITMQ_PASSWORD=