# ==================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - PRODUCCIÓN
# Copia este archivo como ".env" en el servidor real y reemplaza
# cada valor. NUNCA subas el ".env" real a git (ya está en .gitignore).
# ==================================================================

# ---------- Entorno ----------
# Obligatoria. Debe ser exactamente "production".
NODE_ENV=production

# ---------- Base de datos ----------
# Obligatoria. Si el backend vive en Docker junto a "db" (mismo
# docker-compose.yml), usa el nombre del servicio en vez de localhost.
DATABASE_URL=postgresql://usuario:contrasena_fuerte@db:5432/proyectos_db

# ---------- Autenticación (JWT) ----------
# Obligatoria. El servidor NO ARRANCA sin esto (ya lo validamos en
# auth.module.ts). Debe ser larga, aleatoria, y distinta a la de
# desarrollo. Genera una nueva así: openssl rand -base64 48
JWT_SECRET=

# ---------- SSO (Google) ----------
# Obligatoria si van a permitir login con cuentas de Google.
GOOGLE_CLIENT_ID=

# ---------- SSO (Microsoft / Azure AD) ----------
# Obligatorias si van a permitir login con cuentas Microsoft.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=

# ---------- Restricción de dominio corporativo ----------
# Obligatoria. El servidor NO ARRANCA sin esto (ver auth.service.ts).
# Solo se aceptan correos que terminen en "@este-dominio".
ALLOWED_EMAIL_DOMAIN=empresa.com

# ---------- CORS ----------
# Obligatoria. La URL exacta donde vive el frontend en producción.
# Si hay varias (ej. staging + producción), sepáralas por comas.
CORS_ORIGIN=https://sistema-proyectos.empresa.com

# ---------- RabbitMQ (notificaciones) ----------
# Obligatoria si el backend vive en Docker junto a "rabbitmq".
RABBITMQ_URL=amqp://usuario:contrasena_fuerte@rabbitmq:5672
# Opcional. Nombre de la cola. Si se omite, usa "cola_notificaciones_pmo".
RABBITMQ_QUEUE=cola_notificaciones_pmo
# Opcionales. Cuántas veces reintentar un correo fallido, y cuánto
# esperar entre intentos (en milisegundos). Si se omiten, usa 3 y 5000.
NOTIF_MAX_REINTENTOS=3
NOTIF_PAUSA_MS=5000

# ---------- Correo (SMTP) ----------
# Obligatorias todas. En desarrollo usan Ethereal; en producción,
# reemplacen por el proveedor real de correo de la empresa.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistema de Proyectos <no-responder@empresa.com>"

# ---------- Login de desarrollo ----------
# NUNCA en producción. Si es "true", cualquiera puede entrar como
# cualquier usuario por /auth/login-dev. Déjala en false o bórrala.
ALLOW_DEV_LOGIN=false

# ---------- Servidor ----------
# Opcional. Puerto donde escucha el backend (por defecto 3000).
PORT=3000
# Obligatoria si el backend queda detrás de un proxy / balanceador
# (nginx, IIS, Azure App Gateway...). Número de proxies delante del
# backend; normalmente 1. Sin esto, todos los usuarios comparten el
# límite de peticiones de la IP del proxy.
TRUST_PROXY=1
# Opcional. Peticiones permitidas por IP por minuto (por defecto 300).
THROTTLE_LIMIT=300